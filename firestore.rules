rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function getPairId(uidA, uidB) {
      return uidA < uidB ? uidA + '_' + uidB : uidB + '_' + uidA;
    }

    function isPartnerActive(uidA, uidB, date) {
      return get(/databases/$(database)/documents/partnerships/$(getPairId(uidA, uidB))).data.status == 'active' &&
        uidA in get(/databases/$(database)/documents/partnerships/$(getPairId(uidA, uidB))).data.memberUids &&
        date >= get(/databases/$(database)/documents/partnerships/$(getPairId(uidA, uidB))).data.sharingStartDate;
    }

    function isPartnerMemoActive(uidA, uidB) {
      return get(/databases/$(database)/documents/partnerships/$(getPairId(uidA, uidB))).data.status == 'active' &&
        uidA in get(/databases/$(database)/documents/partnerships/$(getPairId(uidA, uidB))).data.memberUids;
    }

    // 1. 邀請碼權限：僅處理 6 位邀請碼申請與原子接受
    match /invitations/{pin} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if request.auth != null && (
        (
          resource.data.status == 'pending' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.acceptedBy == request.auth.uid &&
          resource.data.ownerUid != request.auth.uid
        ) ||
        resource.data.ownerUid == request.auth.uid
      );
    }

    // 2. 對稱 Partnership Single Source of Truth 權限
    match /partnerships/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;
      
      // CREATE: 必須由 Authenticated 成員建立，且 pairId 必須正確對應雙方 Canonical UID 排序組合
      allow create: if request.auth != null &&
        request.resource.data.memberUids.size() == 2 &&
        request.auth.uid in request.resource.data.memberUids &&
        request.resource.data.status == 'active' &&
        pairId == getPairId(request.resource.data.memberUids[0], request.resource.data.memberUids[1]);

      // UPDATE: 成員不可篡改 memberUids / sharingStartDate，僅允許 active -> disconnected 單向離線
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.memberUids &&
        request.resource.data.memberUids == resource.data.memberUids &&
        request.resource.data.sharingStartDate == resource.data.sharingStartDate &&
        resource.data.status == 'active' && request.resource.data.status == 'disconnected';
    }
    
    // 3. 配對 Reference 權限 (僅供 UI 快取)
    match /users/{userId}/partner/info {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (resource != null && request.auth.uid == resource.data.partnerId)
      );
      allow create, update: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.uid == request.resource.data.partnerId
      );
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        (resource != null && request.auth.uid == resource.data.partnerId)
      );
    }

    // 4. 對稱日記讀取權限：直接憑據 partnerships/{pairId} 進行純粹真相檢驗
    match /users/{userId}/diaries/{date} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isPartnerActive(request.auth.uid, userId, date)
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 5. 對稱隨筆讀取權限
    match /users/{userId}/memos/{memoId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isPartnerMemoActive(request.auth.uid, userId)
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 6. 個人 Profile 檔案
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
