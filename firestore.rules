rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. 邀請碼權限：僅處理 6 位邀請碼申請與原子接受
    match /invitations/{pin} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if request.auth != null && (
        (
          resource.data.status == 'pending' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.acceptedBy == request.auth.uid &&
          resource.data.ownerUid != request.auth.uid
        ) ||
        resource.data.ownerUid == request.auth.uid
      );
    }

    // 2. 對稱 Partnership Single Source of Truth 權限 (原子與 getAfter 防偽驗證)
    match /partnerships/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;
      
      // CREATE: 必須由接受者與邀請碼原子點擊觸發，經過 getAfter 嚴格驗證邀請碼已 atomic accepted
      allow create: if request.auth != null &&
        request.resource.data.memberUids.size() == 2 &&
        request.auth.uid in request.resource.data.memberUids &&
        request.resource.data.status == 'active' &&
        pairId == (request.resource.data.memberUids[0] < request.resource.data.memberUids[1] ? request.resource.data.memberUids[0] + '_' + request.resource.data.memberUids[1] : request.resource.data.memberUids[1] + '_' + request.resource.data.memberUids[0]) &&
        (
          let pin = request.resource.data.sourceInvitationId;
          let invAfter = getAfter(/databases/$(database)/documents/invitations/$(pin)).data;
          invAfter.status == 'accepted' &&
          invAfter.acceptedBy == request.auth.uid &&
          invAfter.ownerUid != request.auth.uid &&
          invAfter.ownerUid in request.resource.data.memberUids
        );

      // UPDATE: 成員不可篡改 memberUids / sharingStartDate，僅允許 active -> disconnected 單向離線
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.memberUids &&
        request.resource.data.memberUids == resource.data.memberUids &&
        request.resource.data.sharingStartDate == resource.data.sharingStartDate &&
        resource.data.status == 'active' && request.resource.data.status == 'disconnected';
    }
    
    // 3. 配對 Reference 權限 (僅供 UI 參考)
    match /users/{userId}/partner/info {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.uid == resource.data.partnerId);
      allow create, update: if request.auth != null && (request.auth.uid == userId || request.auth.uid == request.resource.data.partnerId);
      allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.uid == resource.data.partnerId);
    }

    // 4. 對稱日記讀取權限：直接憑據 partnerships/{pairId} 進行純粹真相檢驗
    match /users/{userId}/diaries/{date} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (
          let pairId = request.auth.uid < userId ? request.auth.uid + '_' + userId : userId + '_' + request.auth.uid;
          let pairDoc = get(/databases/$(database)/documents/partnerships/$(pairId)).data;
          pairDoc.status == 'active' &&
          request.auth.uid in pairDoc.memberUids &&
          date >= pairDoc.sharingStartDate
        )
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 5. 對稱隨筆讀取權限
    match /users/{userId}/memos/{memoId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (
          let pairId = request.auth.uid < userId ? request.auth.uid + '_' + userId : userId + '_' + request.auth.uid;
          let pairDoc = get(/databases/$(database)/documents/partnerships/$(pairId)).data;
          pairDoc.status == 'active' &&
          request.auth.uid in pairDoc.memberUids
        )
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 6. 個人 Profile 檔案
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
