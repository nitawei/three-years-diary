rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. 邀請碼權限：允許登入使用者建立、讀取與核對邀請碼
    match /invitations/{pin} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null && (resource.data.ownerUid == request.auth.uid || resource.data.status == 'pending');
    }
    
    // 2. 配對資訊權限：允許讀取/寫入自己的 partner info，或相互設定 partnerId
    match /users/{userId}/partner/info {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.uid == resource.data.partnerId);
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.uid == request.resource.data.partnerId);
    }

    // 3. 日記與隨筆權限：允許本人讀寫，且僅允許已配對成功之 Partner 讀取
    match /users/{userId}/diaries/{date} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(userId)/partner/info).data.partnerId == request.auth.uid
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/memos/{memoId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(userId)/partner/info).data.partnerId == request.auth.uid
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 4. 個人 Profile 檔案
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
