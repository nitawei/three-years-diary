rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function getPairId(uidA, uidB) {
      return uidA < uidB ? uidA + '_' + uidB : uidB + '_' + uidA;
    }

    function isPartnerActive(uidA, uidB, date) {
      return get(/databases/$(database)/documents/partnerships/$(getPairId(uidA, uidB))).data.status == 'active' &&
        uidA in get(/databases/$(database)/documents/partnerships/$(getPairId(uidA, uidB))).data.memberUids &&
        date >= get(/databases/$(database)/documents/partnerships/$(getPairId(uidA, uidB))).data.sharingStartDate;
    }

    function isPartnerMemoActive(uidA, uidB, date) {
      let pairData = get(/databases/$(database)/documents/partnerships/$(getPairId(uidA, uidB))).data;
      return pairData.status == 'active' &&
        uidA in pairData.memberUids &&
        date >= pairData.sharingStartDate;
    }

    // 1. 邀請碼權限：嚴格狀態機、時效過期、與 affectedKeys 不可變欄位鎖定
    match /invitations/{pin} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      
      allow update: if request.auth != null &&
        resource.data.status == 'pending' &&
        (!('expiresAt' in resource.data) || resource.data.expiresAt == null || request.time < resource.data.expiresAt) &&
        (
          // Acceptor (非建立者): 僅允許 pending -> accepted，僅得修改 status, acceptedBy, acceptedAt 欄位
          (
            resource.data.ownerUid != request.auth.uid &&
            request.resource.data.status == 'accepted' &&
            request.resource.data.acceptedBy == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt'])
          ) ||
          // Owner (建立者): 僅允許 pending -> cancelled，僅得修改 status, cancelledAt 欄位
          (
            resource.data.ownerUid == request.auth.uid &&
            request.resource.data.status == 'cancelled' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
          )
        );
    }

    // 2. 對稱 Partnership Single Source of Truth 權限 (原子與 getAfter 嚴格雙向綁定驗證)
    match /partnerships/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;
      
      // CREATE: 必須由接受者與邀請碼原子點擊觸發，getAfter 嚴格驗證 ownerUid & acceptedBy 雙重綁定
      allow create: if request.auth != null &&
        request.resource.data.memberUids.size() == 2 &&
        request.auth.uid in request.resource.data.memberUids &&
        request.resource.data.status == 'active' &&
        pairId == getPairId(request.resource.data.memberUids[0], request.resource.data.memberUids[1]) &&
        getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.sourceInvitationId)).data.status == 'accepted' &&
        getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.sourceInvitationId)).data.acceptedBy == request.auth.uid &&
        getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.sourceInvitationId)).data.ownerUid != request.auth.uid &&
        getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.sourceInvitationId)).data.ownerUid in request.resource.data.memberUids;

      // UPDATE: 允許成員從 active -> disconnected (解除配對) 或 disconnected -> active (重新配對)
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.memberUids &&
        (
          // 1. 解除配對: active -> disconnected
          (
            resource.data.status == 'active' &&
            request.resource.data.status == 'disconnected' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'disconnectedAt'])
          ) ||
          // 2. 重新配對: disconnected -> active (必須透過新邀請碼原子 commit 驗證)
          (
            resource.data.status == 'disconnected' &&
            request.resource.data.status == 'active' &&
            request.resource.data.memberUids == resource.data.memberUids &&
            getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.sourceInvitationId)).data.status == 'accepted' &&
            getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.sourceInvitationId)).data.acceptedBy == request.auth.uid &&
            getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.sourceInvitationId)).data.ownerUid != request.auth.uid &&
            getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.sourceInvitationId)).data.ownerUid in request.resource.data.memberUids &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'sharingStartDate', 'sourceInvitationId', 'createdAt', 'disconnectedAt'])
          )
        );
    }
    
    // 3. 配對 Reference 權限 (100% 個人私有領域，禁止跨使用者寫入)
    match /users/{userId}/partner/info {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 4. 對稱日記讀取權限：明確拆分 get (單文件) 與 list (集合查詢)
    match /users/{userId}/diaries/{date} {
      allow get: if request.auth != null && (
        request.auth.uid == userId ||
        isPartnerActive(request.auth.uid, userId, date)
      );
      allow list: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 5. 對稱隨筆讀取權限：明確拆分 get (單文件，含 date >= sharingStartDate 隱私驗證) 與 list (集合查詢)
    match /users/{userId}/memos/{memoId} {
      allow get: if request.auth != null && (
        request.auth.uid == userId ||
        (
          'date' in resource.data &&
          resource.data.date != null &&
          isPartnerMemoActive(request.auth.uid, userId, resource.data.date)
        )
      );
      allow list: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // 6. 個人 Profile 檔案 (100% 私有隔離)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
